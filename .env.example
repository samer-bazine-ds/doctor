# Définissez ces variables dans votre terminal ou chez votre hébergeur.
# Ce fichier d’exemple n’est pas chargé automatiquement par le serveur.
PORT=3000
ADMIN_EMAIL=admin@pulse.local
# Mot de passe du premier administrateur ; sinon un mot de passe est généré.
ADMIN_PASSWORD=
# En production, un proxy HTTPS est nécessaire pour les cookies sécurisés.
NODE_ENV=production
# Adresse HTTPS publique ; elle est détectée automatiquement dans Codespaces.
PUBLIC_ORIGIN=
# Adaptateur d’envoi d’e-mails facultatif ; reçoit {id,to,subject,text}.
EMAIL_WEBHOOK=
EMAIL_WEBHOOK_TOKEN=
# Optional SMS adapter; receives {id,to,message,appointmentId,kind}.
SMS_WEBHOOK=
SMS_WEBHOOK_TOKEN=
# Google Calendar OAuth is optional. PUBLIC_ORIGIN must be an HTTPS public URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Supabase project configuration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
# Server-only key; add it to .env and Cloudflare secrets, never to frontend code.
SUPABASE_SERVICE_ROLE_KEY=
# Public browser configuration for a future Supabase Realtime client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
# Leave empty locally; set this to the deployed Worker URL in Cloudflare Pages.
VITE_API_BASE_URL=
