# Définissez ces variables dans votre terminal ou chez votre hébergeur.
# Ce fichier d’exemple n’est pas chargé automatiquement par le serveur.
PORT=3000
ADMIN_EMAIL=admin@pulse.local
# Mot de passe du premier administrateur ; sinon un mot de passe est généré.
ADMIN_PASSWORD=
# En production, un proxy HTTPS est nécessaire pour les cookies sécurisés.
NODE_ENV=production
# Adresse HTTPS publique ; elle est détectée automatiquement dans Codespaces.
PUBLIC_ORIGIN=
# Adaptateur d’envoi d’e-mails facultatif ; reçoit {id,to,subject,text}.
EMAIL_WEBHOOK=
EMAIL_WEBHOOK_TOKEN=
